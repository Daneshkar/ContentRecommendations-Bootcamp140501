@{
    Layout = null;
    ViewData["Title"] = "WatchPair — Find what feels right";
}

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Discover movies, books, games, and music shaped by your mood and experiences." />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body>
    <div class="landing-shell">
        <header class="landing-header">
            <a class="brand" href="#top" aria-label="WatchPair home">
                <span class="brand-mark" aria-hidden="true">
                    <span></span>
                    <span></span>
                </span>
                <span class="brand-name">WatchPair</span>
            </a>

            <nav class="primary-nav" aria-label="Primary navigation">
                <a href="#how-it-works">How it works</a>
                <a href="#discover">Discover</a>
                <a href="#team">Team</a>
            </nav>

            <div class="header-actions">
                <a class="button button-quiet" asp-controller="Account" asp-action="Login">Sign in</a>
                <a class="button button-primary button-compact" asp-controller="Account" asp-action="Register">Create account</a>
            </div>
        </header>

        <main id="top">
            <section class="hero" aria-labelledby="hero-title">
                <div class="hero-glow" aria-hidden="true"></div>
                <img class="hero-artwork"
                     src="~/images/auth/login-discovery.webp"
                     asp-append-version="true"
                     alt=""
                     aria-hidden="true" />

                <div class="hero-content page-width">
                    <div class="hero-copy">
                        <p class="eyebrow">EMOTION-AWARE DISCOVERY</p>
                        <h1 id="hero-title">Find what<br />feels right.</h1>
                        <p class="hero-description">
                            Discover movies, books, games, and music shaped by your mood and experiences.
                        </p>

                        <div class="hero-actions">
                            <a class="button button-primary button-large" href="#discover">
                                Start with a Mood
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
                            </a>
                            <a class="button button-secondary button-large" href="#discover">Share an Experience</a>
                        </div>

                        <div class="hero-note">
                            <span class="spark" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="m13.5 2-8 11h6L10.5 22l8-12h-6l1-8Z" /></svg>
                            </span>
                            <strong>Personalized in moments.</strong>
                            <span>Thoughtful. Diverse. Always something new.</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="section discovery-section" id="discover" aria-labelledby="discover-title">
                <div class="page-width">
                    <div class="section-heading">
                        <div>
                            <p class="section-kicker">YOUR WAY IN</p>
                            <h2 id="discover-title">Two ways to discover</h2>
                        </div>
                        <p>However you get inspired, WatchPair meets you there.</p>
                    </div>

                    <div class="discovery-grid">
                        <article class="discovery-card mood-discovery">
                            <div class="discovery-card-copy">
                                <span class="card-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M8.5 10h.01m7 0h.01M8 15c1.1 1.2 2.4 1.8 4 1.8s2.9-.6 4-1.8" /></svg>
                                </span>
                                <h3>Choose by Mood</h3>
                                <p>Pick how you feel and let WatchPair find the right match.</p>
                                <a asp-controller="Account" asp-action="Login">
                                    Start with a Mood
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
                                </a>
                            </div>
                            <div class="mood-wave" aria-hidden="true"><span></span><span></span><span></span></div>
                        </article>

                        <article class="discovery-card experience-discovery">
                            <div class="discovery-card-copy">
                                <span class="card-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="M4 6.5A3.5 3.5 0 0 1 7.5 3H11v17H7.5A3.5 3.5 0 0 0 4 23V6.5ZM20 6.5A3.5 3.5 0 0 0 16.5 3H13v17h3.5A3.5 3.5 0 0 1 20 23V6.5Z" /></svg>
                                </span>
                                <h3>Start from an Experience</h3>
                                <p>Tell us what stayed with you and discover something with a similar emotional tone.</p>
                                <a asp-controller="Account" asp-action="Login">
                                    Share an Experience
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
                                </a>
                            </div>
                            <div class="experience-cards" aria-hidden="true">
                                <span></span><span></span><span></span>
                            </div>
                        </article>
                    </div>
                </div>
            </section>

            <section class="section process-section" id="how-it-works" aria-labelledby="process-title">
                <div class="page-width">
                    <div class="section-heading">
                        <div>
                            <p class="section-kicker">A SIMPLE PROCESS</p>
                            <h2 id="process-title">How WatchPair works</h2>
                        </div>
                        <p>A more meaningful way to discover your next story.</p>
                    </div>

                    <ol class="process-list">
                        <li>
                            <span class="step-number">01</span>
                            <span class="step-icon step-coral" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M8.5 10h.01m7 0h.01M8 15c1.1 1.2 2.4 1.8 4 1.8s2.9-.6 4-1.8" /></svg>
                            </span>
                            <div>
                                <h3>Tell us what you feel</h3>
                                <p>Choose a mood or share an experience in your own words.</p>
                            </div>
                        </li>
                        <li>
                            <span class="step-number">02</span>
                            <span class="step-icon step-violet" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="M3 12h3l2-6 4 13 3-10 2 3h4" /></svg>
                            </span>
                            <div>
                                <h3>We match the emotional tone</h3>
                                <p>WatchPair connects the feeling behind your interests.</p>
                            </div>
                        </li>
                        <li>
                            <span class="step-number">03</span>
                            <span class="step-icon step-pink" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="m12 3 1.7 5.3L19 10l-5.3 1.7L12 17l-1.7-5.3L5 10l5.3-1.7L12 3Z" /><path d="m19 15 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z" /></svg>
                            </span>
                            <div>
                                <h3>Discover your next favorite</h3>
                                <p>Get a focused recommendation across movies, books, games, and music.</p>
                            </div>
                        </li>
                    </ol>
                </div>
            </section>

            <section class="section media-section" aria-labelledby="media-title">
                <div class="page-width">
                    <div class="section-heading">
                        <div>
                            <p class="section-kicker">ONE FEELING, MANY WORLDS</p>
                            <h2 id="media-title">Made for every kind of story</h2>
                        </div>
                        <p>Different worlds. The same human emotions.</p>
                    </div>

                    <div class="media-grid">
                        <article class="media-tile media-movie">
                            <div class="media-image" aria-hidden="true"></div>
                            <div class="media-copy">
                                <span class="media-label">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v13H4zM4 11h16M7 4l2 3m3-3 2 3m3-3 2 3" /></svg>
                                    Movies
                                </span>
                                <p>From heartfelt dramas to mind-bending adventures.</p>
                            </div>
                        </article>
                        <article class="media-tile media-book">
                            <div class="media-image" aria-hidden="true"></div>
                            <div class="media-copy">
                                <span class="media-label">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v17H7.5A3.5 3.5 0 0 0 4 22V5.5ZM20 5.5A3.5 3.5 0 0 0 16.5 2H13v17h3.5A3.5 3.5 0 0 1 20 22V5.5Z" /></svg>
                                    Books
                                </span>
                                <p>Stories that stay with you long after the last page.</p>
                            </div>
                        </article>
                        <article class="media-tile media-game">
                            <div class="media-image" aria-hidden="true"></div>
                            <div class="media-copy">
                                <span class="media-label">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h8a5 5 0 0 1 4.7 3.3l1.1 3.2A3.4 3.4 0 0 1 18.6 19c-1 0-1.9-.4-2.5-1.1L14.4 16H9.6l-1.7 1.9A3.4 3.4 0 0 1 2.2 14.5l1.1-3.2A5 5 0 0 1 8 8Z" /><path d="M8 11v4m-2-2h4m7-1h.01m2 2h.01" /></svg>
                                    Games
                                </span>
                                <p>Immersive worlds for every state of mind.</p>
                            </div>
                        </article>
                        <article class="media-tile media-music">
                            <div class="media-image" aria-hidden="true"></div>
                            <div class="media-copy">
                                <span class="media-label">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l10-2v13M9 10l10-2" /><circle cx="6" cy="18" r="3" /><circle cx="16" cy="16" r="3" /></svg>
                                    Music
                                </span>
                                <p>Soundtracks for every chapter and every feeling.</p>
                            </div>
                        </article>
                    </div>
                </div>
            </section>

            <section class="section team-section" id="team" aria-labelledby="team-title">
                <div class="page-width">
                    <div class="section-heading">
                        <div>
                            <p class="section-kicker">BEHIND WATCHPAIR</p>
                            <h2 id="team-title">Meet the team</h2>
                        </div>
                        <p>The people building more human recommendations.</p>
                    </div>

                    <div class="team-grid">
                        <article class="team-card team-lead">
                            <div class="team-photo placeholder-one" role="img" aria-label="Photo placeholder for Ali Hatefi">
                                <span>AH</span>
                            </div>
                            <div class="team-copy">
                                <h3>Ali Hatefi</h3>
                                <p>Team Lead</p>
                            </div>
                        </article>
                        <article class="team-card">
                            <div class="team-photo placeholder-two" role="img" aria-label="Photo placeholder for Soroush Hanifi">
                                <span>SH</span>
                            </div>
                            <div class="team-copy">
                                <h3>Soroush Hanifi</h3>
                                <p>Team Member</p>
                            </div>
                        </article>
                        <article class="team-card">
                            <div class="team-photo placeholder-three" role="img" aria-label="Photo placeholder for Sahar Rahmannia">
                                <span>SR</span>
                            </div>
                            <div class="team-copy">
                                <h3>Sahar Rahmannia</h3>
                                <p>Team Member</p>
                            </div>
                        </article>
                        <article class="team-card">
                            <div class="team-photo placeholder-four" role="img" aria-label="Photo placeholder for Amir Saadatnia">
                                <span>AS</span>
                            </div>
                            <div class="team-copy">
                                <h3>Amir Saadatnia</h3>
                                <p>Team Member</p>
                            </div>
                        </article>
                    </div>
                </div>
            </section>

            <section class="final-cta page-width" aria-labelledby="cta-title">
                <div class="cta-overlay" aria-hidden="true"></div>
                <div class="cta-content">
                    <p class="section-kicker">YOUR NEXT STORY IS WAITING</p>
                    <h2 id="cta-title">Ready to find your next favorite?</h2>
                    <p>Let your emotions guide you to something extraordinary.</p>
                    <div class="cta-actions">
                        <a class="button button-primary button-large" href="#discover">
                            Start discovering
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
                        </a>
                        <a class="button button-secondary button-large" asp-controller="Account" asp-action="Login">Sign in</a>
                    </div>
                </div>
            </section>
        </main>

        <footer class="landing-footer">
            <div class="page-width footer-content">
                <div>
                    <a class="brand footer-brand" href="#top" aria-label="WatchPair home">
                        <span class="brand-mark" aria-hidden="true"><span></span><span></span></span>
                        <span class="brand-name">WatchPair</span>
                    </a>
                    <p>Recommendations that begin with how you feel.</p>
                </div>

                <nav aria-label="Footer navigation">
                    <a href="#how-it-works">How it works</a>
                    <a href="#discover">Discover</a>
                    <a href="#team">Team</a>
                </nav>

                <p class="copyright">&copy; @DateTime.UtcNow.Year WatchPair. All rights reserved.</p>
            </div>
        </footer>
    </div>
</body>
</html>
