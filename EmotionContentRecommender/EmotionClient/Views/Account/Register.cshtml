@model RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Create your account";
    var today = DateTime.UtcNow.ToString("yyyy-MM-dd");
}

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Create your WatchPair account and start discovering content shaped by how you feel." />
    <title>Create your account — WatchPair</title>
    <link rel="stylesheet" href="~/css/auth-login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-register.css" asp-append-version="true" />
</head>
<body class="register-body">
    <div class="auth-shell">
        <header class="auth-header">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="WatchPair home">
                <span class="brand-mark" aria-hidden="true"><span></span><span></span></span>
                <span class="brand-name">WatchPair</span>
            </a>
            <a class="home-link" asp-controller="Home" asp-action="Index">
                Back to Home
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
            </a>
        </header>

        <main class="auth-main register-main">
            <section class="auth-story register-story" aria-labelledby="register-story-title">
                <img class="story-artwork" src="~/images/auth/login-discovery.webp" asp-append-version="true" alt="" aria-hidden="true" />
                <div class="story-copy register-story-copy">
                    <p class="auth-kicker">YOUR STORY, YOUR MOOD</p>
                    <h1 id="register-story-title">Make every recommendation feel personal.</h1>
                    <p class="story-description">Tell WatchPair what stays with you, and discover what should come next.</p>
                    <div class="register-benefits" aria-label="WatchPair account benefits">
                        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 12 4 4 8-9" /></svg>Mood-aware matches</span>
                        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 12 4 4 8-9" /></svg>Experience-based discovery</span>
                        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 12 4 4 8-9" /></svg>A history shaped by you</span>
                    </div>
                </div>
            </section>

            <section class="register-panel" aria-labelledby="register-title">
                <div class="register-card">
                    <div class="register-heading">
                        <div>
                            <p class="auth-kicker">JOIN WATCHPAIR</p>
                            <h2 id="register-title">Create your account</h2>
                            <p>Start with the essentials. Personal details are optional.</p>
                        </div>
                        <span class="register-step">Account setup</span>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="auth-alert auth-alert-error" role="alert">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v6m0 4h.01" /></svg>
                            <span>@ViewBag.Error</span>
                        </div>
                    }
                    <div asp-validation-summary="All" class="register-validation-summary" role="alert"></div>

                    <form asp-action="Register" method="post" class="register-form" id="register-form" novalidate>
                        <div class="register-grid">
                            <div class="field-group">
                                <label asp-for="Username">Username <span aria-hidden="true">*</span></label>
                                <div class="field-control">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4.5 21a7.5 7.5 0 0 1 15 0" /></svg>
                                    <input asp-for="Username" placeholder="Choose a username" autocomplete="username" spellcheck="false" minlength="3" maxlength="100" pattern="[A-Za-z0-9_]+" autofocus required />
                                </div>
                                <span asp-validation-for="Username" class="field-error"></span>
                            </div>

                            <div class="field-group">
                                <label asp-for="Email">Email <span class="field-optional">email or mobile required</span></label>
                                <div class="field-control">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3z" /><path d="m4 7 8 6 8-6" /></svg>
                                    <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="email" maxlength="256" />
                                </div>
                                <span asp-validation-for="Email" class="field-error"></span>
                            </div>

                            <div class="field-group">
                                <label asp-for="FirstName">First name <span class="field-optional">optional</span></label>
                                <div class="field-control">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20c.8-4 3.5-6 8-6s7.2 2 8 6M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /></svg>
                                    <input asp-for="FirstName" placeholder="Your first name" autocomplete="given-name" maxlength="100" />
                                </div>
                                <span asp-validation-for="FirstName" class="field-error"></span>
                            </div>

                            <div class="field-group">
                                <label asp-for="LastName">Last name <span class="field-optional">optional</span></label>
                                <div class="field-control">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20c.8-4 3.5-6 8-6s7.2 2 8 6M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /></svg>
                                    <input asp-for="LastName" placeholder="Your last name" autocomplete="family-name" maxlength="100" />
                                </div>
                                <span asp-validation-for="LastName" class="field-error"></span>
                            </div>

                            <div class="field-group">
                                <label asp-for="Mobile">Mobile <span class="field-optional">email or mobile required</span></label>
                                <div class="field-control">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2" /><path d="M10 5h4m-3 14h2" /></svg>
                                    <input asp-for="Mobile" type="tel" placeholder="09xxxxxxxxx" autocomplete="tel" inputmode="numeric" pattern="09[0-9]{9}" maxlength="11" />
                                </div>
                                <span asp-validation-for="Mobile" class="field-error"></span>
                            </div>

                            <div class="field-group">
                                <label asp-for="BirthDay">Date of birth <span class="field-optional">optional</span></label>
                                <div class="field-control field-control-date">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M7 3v4m10-4v4M3 10h18" /></svg>
                                    <input asp-for="BirthDay" type="date" max="@today" autocomplete="bday" />
                                </div>
                                <span asp-validation-for="BirthDay" class="field-error"></span>
                            </div>

                            <div class="field-group">
                                <label asp-for="Gender">Gender <span class="field-optional">optional</span></label>
                                <div class="field-control field-control-select">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 8v8m-4-4h8" /></svg>
                                    <select asp-for="Gender">
                                        <option value="">Prefer not to say</option>
                                        <option value="1">Man</option>
                                        <option value="2">Woman</option>
                                        <option value="3">Other</option>
                                    </select>
                                    <svg class="select-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
                                </div>
                                <span asp-validation-for="Gender" class="field-error"></span>
                            </div>

                            <div class="contact-requirement" id="contact-requirement" role="status">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v6m0-10h.01" /></svg>
                                Enter at least one way to reach you: email or mobile.
                            </div>

                            <div class="field-group">
                                <label asp-for="Password">Password <span aria-hidden="true">*</span></label>
                                <div class="field-control">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2" /></svg>
                                    <input asp-for="Password" type="password" placeholder="At least 6 characters" autocomplete="new-password" minlength="6" maxlength="100" required />
                                    <button class="password-toggle" type="button" data-password-toggle="Password" aria-label="Show password" aria-pressed="false">
                                        <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.5" /></svg>
                                        <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true"><path d="m4 4 16 16M10.7 6.1A9.8 9.8 0 0 1 12 6c6 0 9.5 6 9.5 6a15 15 0 0 1-2.2 2.8M6.6 6.6C4 8.3 2.5 12 2.5 12s3.5 6 9.5 6a9 9 0 0 0 3-.5M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="field-error"></span>
                            </div>

                            <div class="field-group">
                                <label asp-for="ConfirmPassword">Confirm password <span aria-hidden="true">*</span></label>
                                <div class="field-control">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2" /></svg>
                                    <input asp-for="ConfirmPassword" type="password" placeholder="Enter it again" autocomplete="new-password" minlength="6" maxlength="100" required />
                                    <button class="password-toggle" type="button" data-password-toggle="ConfirmPassword" aria-label="Show password confirmation" aria-pressed="false">
                                        <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.5" /></svg>
                                        <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true"><path d="m4 4 16 16M10.7 6.1A9.8 9.8 0 0 1 12 6c6 0 9.5 6 9.5 6s-3.5 6-9.5 6a9 9 0 0 1-3-.5" /></svg>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="field-error" id="password-match-error"></span>
                            </div>
                        </div>

                        <button type="submit" class="submit-button register-submit" id="register-submit">
                            <span class="submit-label">Create my account</span>
                            <span class="submit-spinner" aria-hidden="true"></span>
                        </button>
                    </form>

                    <div class="register-prompt register-signin-prompt">
                        <span>Already have an account?</span>
                        <a asp-action="Login">Sign in</a>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <script src="~/js/auth-register.js" asp-append-version="true"></script>
</body>
</html>
