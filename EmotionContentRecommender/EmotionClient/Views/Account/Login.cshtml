@model LoginViewModel
@{
    ViewData["Title"] = "ورود";
}

<div class="auth-page">
    <div class="auth-card">
        <h2>ورود به Emotion</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-error">@ViewBag.Error</div>
        }
        @if (ViewBag.Info != null)
        {
            <div class="alert alert-info">@ViewBag.Info</div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info">@TempData["Info"]</div>
        }

        <form asp-action="Login" method="post">
            <div class="form-group">
                <label>نام کاربری</label>
                <input asp-for="Username" placeholder="نام کاربری خود را وارد کنید" autocomplete="username" />
            </div>

            <div class="form-group">
                <label>رمز عبور</label>
                <input asp-for="Password" type="password" placeholder="رمز عبور خود را وارد کنید" autocomplete="current-password" />
            </div>

            <button type="submit" class="btn">ورود</button>
        </form>

        <div class="auth-links">
            حساب کاربری ندارید؟
            <a asp-action="Register">ثبت‌نام کنید</a>
        </div>
    </div>
</div>
