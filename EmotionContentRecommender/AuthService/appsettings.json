{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost;Initial Catalog=EmotionServiceDb;Integrated Security=True;Trust Server Certificate=True"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "AuthService",
    "Audience": "EmotionApp",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Kavenegar": {
    "ApiKey": "YourKavenegarApiKey",
    "Sender": "10008663",
    "Template": "verify"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
